<UserControl x:Class="Translate.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Translate">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="API 设置" FontSize="27" FontWeight="Bold"/><TextBlock Text="管理翻译供应商、模型和所有翻译入口共用的提示词。" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
      <TextBlock Text="翻译服务" Style="{StaticResource Muted}" Margin="8,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,22"><StackPanel>
        <TextBlock Text="服务提供商" Margin="0,0,0,8" FontSize="12"/><ComboBox x:Name="ProviderBox" SelectedValuePath="Tag" SelectionChanged="ProviderBox_SelectionChanged"><ComboBoxItem Content="OpenAI" Tag="openai"/><ComboBoxItem Content="DeepSeek" Tag="deepseek"/><ComboBoxItem Content="其他 OpenAI 兼容服务" Tag="custom"/></ComboBox>
        <TextBlock Text="提供商名称" FontSize="12" Margin="0,16,0,8"/><TextBox x:Name="ProviderNameBox" AutomationProperties.Name="提供商名称"/>
        <TextBlock Text="API 接口地址" FontSize="12" Margin="0,16,0,8"/><TextBox x:Name="BaseUrlBox" AutomationProperties.Name="API 接口地址" TextChanged="CatalogCredentials_Changed"/>
        <TextBlock Text="填写服务商提供的 Base URL，例如 https://api.openai.com/v1" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="翻译模型" Margin="0,0,0,8" FontSize="12"/><ComboBox x:Name="ModelBox" IsEditable="False" IsTextSearchEnabled="True" MaxDropDownHeight="260" AutomationProperties.Name="翻译模型列表" SelectionChanged="ModelBox_SelectionChanged"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="超时（秒）" Margin="0,0,0,8" FontSize="12"/><TextBox x:Name="TimeoutBox" AutomationProperties.Name="请求超时秒数"/></StackPanel>
        </Grid>
        <DockPanel Margin="0,10,0,0"><Button x:Name="RefreshModelsButton" DockPanel.Dock="Right" Content="刷新模型" Click="RefreshModels_Click" Padding="12,8" Margin="12,0,0,0"/><TextBlock x:Name="ModelStatus" Style="{StaticResource Muted}" FontSize="11" Text="填写 API Key 后获取可选模型。"/></DockPanel>
        <TextBlock Text="推理强度" FontSize="12" Margin="0,16,0,8"/>
        <ComboBox x:Name="ReasoningBox" IsEditable="False" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="推理强度"/>
        <TextBlock x:Name="ReasoningHint" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
        <TextBlock Text="API Key" FontSize="12" Margin="0,16,0,8"/><PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="翻译 API Key" PasswordChanged="CatalogCredentials_Changed"/>
        <TextBlock Text="各供应商的密钥独立加密保存，切换不会删除或串用密钥。点击「保存设置」后，下次打开仍会保留。" Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/>
        <Button x:Name="TestButton" Content="测试翻译连接" HorizontalAlignment="Left" Margin="0,16,0,0" Click="TestConnection_Click"/>
        <TextBlock x:Name="TestResult" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="提示词与约束" Style="{StaticResource Muted}" Margin="8,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="系统提示词 · 所有翻译入口共用" FontSize="12" Margin="0,0,0,10"/><TextBox x:Name="PromptBox" MinHeight="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="翻译系统提示词"/><TextBlock Text="使用 {targetLanguage} 引用目标语言。可约束术语、语气、格式和输出内容。" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border>
      <TextBlock Text="兼容 Chat Completions 协议；其他协议可通过独立翻译服务适配器扩展。" Style="{StaticResource Muted}" FontSize="11" Margin="8,14,8,10"/>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ValidationMessage" Foreground="#D64C4C" TextWrapping="Wrap" FontSize="12" Margin="0,0,16,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="放弃修改" Click="Cancel_Click" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource Primary}" Click="Save_Click"/></StackPanel>
    </Grid>
  </Grid>
</UserControl>
