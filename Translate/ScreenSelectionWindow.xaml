<Window x:Class="Translate.ScreenSelectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框选屏幕 · Translate" WindowStyle="None" ResizeMode="NoResize" Background="Black" Topmost="True" ShowInTaskbar="False" Cursor="Cross">
  <Grid MouseLeftButtonDown="Selection_MouseDown" MouseMove="Selection_MouseMove" MouseLeftButtonUp="Selection_MouseUp" MouseRightButtonUp="Selection_Cancel">
    <Image x:Name="DesktopImage" Stretch="Fill"/>
    <Path x:Name="Shade" Fill="#770D1628" IsHitTestVisible="False"/>
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
      <Border x:Name="Selection" BorderBrush="#007AFF" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
      <Border x:Name="SizeBadge" Background="#F5007AFF" CornerRadius="7" Padding="10,5" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="SizeLabel" Foreground="White" FontSize="12"/></Border>
      <Border x:Name="Instructions" Background="#F5FFFFFF" CornerRadius="15" Padding="22,14" IsHitTestVisible="False"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C5;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/><TextBlock Text="拖拽选择区域" Foreground="#202633" FontWeight="SemiBold"/><TextBlock Text="  ·  松开识别   /   Esc 或右键取消" Foreground="#7B8495" FontSize="12"/></StackPanel></Border>
    </Canvas>
  </Grid>
</Window>
