<UserControl x:Class="Translate.SoftwareSettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Translate">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="软件设置" FontSize="27" FontWeight="Bold"/><TextBlock Text="管理快捷键、输出语言和启动行为。" Style="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
      <TextBlock Text="启动与后台" Style="{StaticResource Muted}" Margin="8,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,22"><StackPanel>
        <CheckBox x:Name="StartAtLoginBox" Style="{StaticResource Toggle}" Content="开机自启动（当前 Windows 用户登录时）"/>
        <CheckBox x:Name="SilentStartupBox" Style="{StaticResource Toggle}" Content="静默启动，只显示托盘图标" Margin="0,20,0,0"/>
        <CheckBox x:Name="BackgroundBox" Style="{StaticResource Toggle}" Content="关闭主窗口后继续在后台运行" Margin="0,20,0,0"/>
        <TextBlock Text="后台可随时按快捷键截图；双击托盘图标打开主界面，右键可截图或彻底退出。" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
      </StackPanel></Border>
      <TextBlock Text="快捷翻译" Style="{StaticResource Muted}" Margin="8,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,22"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="划词翻译快捷键" FontWeight="SemiBold"/><TextBlock Text="在 PDF 或其他应用中选中文字，按快捷键直接翻译" Style="{StaticResource Muted}" Margin="0,6,12,0" FontSize="11"/></StackPanel>
          <TextBox x:Name="SelectionHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextAlignment="Center" FontFamily="Consolas" ToolTip="点击后按下新的组合键，不能与其他快捷键相同" AutomationProperties.Name="划词翻译快捷键"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="输入翻译悬浮窗快捷键" FontWeight="SemiBold"/><TextBlock Text="按快捷键打开悬浮窗，输入后按 Ctrl+Enter 翻译" Style="{StaticResource Muted}" Margin="0,6,12,0" FontSize="11"/></StackPanel>
          <TextBox x:Name="QuickHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextAlignment="Center" FontFamily="Consolas" ToolTip="点击后按下新的组合键，不能与其他快捷键相同" AutomationProperties.Name="输入翻译快捷键"/>
        </Grid>
      </StackPanel></Border>
      <TextBlock Text="截图与识别" Style="{StaticResource Muted}" Margin="8,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,22"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="全局截图快捷键" FontWeight="SemiBold"/><TextBlock Text="点击右侧，按下新的组合键" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="11"/></StackPanel>
          <TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextAlignment="Center" FontFamily="Consolas" ToolTip="需要 Ctrl、Alt、Shift 或 Win，加字母、数字或功能键" AutomationProperties.Name="截图快捷键"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="截图并翻译快捷键" FontWeight="SemiBold"/><TextBlock Text="截图后自动识别并翻译为所选输出语言" Style="{StaticResource Muted}" Margin="0,6,12,0" FontSize="11"/></StackPanel>
          <TextBox x:Name="TranslateHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextAlignment="Center" FontFamily="Consolas" ToolTip="点击后按下新的组合键，不能与截图快捷键相同" AutomationProperties.Name="截图并翻译快捷键"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19"/>
        <CheckBox x:Name="AutoCopyBox" Style="{StaticResource Toggle}"><StackPanel><TextBlock Text="识别后自动复制" FontWeight="SemiBold"/><TextBlock Text="完成后将文字放入剪贴板" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel></CheckBox>
      </StackPanel></Border>
      <TextBlock Text="各入口目标语言" Style="{StaticResource Muted}" Margin="8,0,0,9"/>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,22"><StackPanel>
        <TextBlock Text="每个入口独立保存，可选择或直接输入语言名称。" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="软件内翻译" FontWeight="SemiBold"/><TextBlock Text="左侧「翻译」页面" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0"/></StackPanel>
          <ComboBox x:Name="WorkspaceLanguageBox" Grid.Column="1" IsEditable="True" ItemsSource="{x:Static local:LanguageOptions.Common}" AutomationProperties.Name="软件内翻译目标语言"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="划词翻译" FontWeight="SemiBold"/><TextBlock Text="选中文字后通过快捷键翻译" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0"/></StackPanel>
          <ComboBox x:Name="SelectionLanguageBox" Grid.Column="1" IsEditable="True" ItemsSource="{x:Static local:LanguageOptions.Common}" AutomationProperties.Name="划词翻译目标语言"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="截图翻译" FontWeight="SemiBold"/><TextBlock Text="截图后自动翻译及识别结果翻译" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0"/></StackPanel>
          <ComboBox x:Name="LanguageBox" Grid.Column="1" IsEditable="True" ItemsSource="{x:Static local:LanguageOptions.Common}" AutomationProperties.Name="截图翻译目标语言"/>
        </Grid>
        <Border Height="1" Background="{StaticResource Line}" Margin="0,19"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="输入悬浮窗" FontWeight="SemiBold"/><TextBlock Text="通过快捷键打开的小窗" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,12,0"/></StackPanel>
          <ComboBox x:Name="QuickLanguageBox" Grid.Column="1" IsEditable="True" ItemsSource="{x:Static local:LanguageOptions.Common}" AutomationProperties.Name="输入悬浮窗目标语言"/>
        </Grid>
        <TextBlock Text="各入口仍使用 API 设置中的提示词约束，{targetLanguage} 会替换为该入口的目标语言。" Style="{StaticResource Muted}" FontSize="11" Margin="0,18,0,0"/>
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,18,0,0">
      <Button DockPanel.Dock="Right" Content="保存设置" Style="{StaticResource Primary}" Click="Save_Click"/>
      <Button DockPanel.Dock="Right" Content="放弃修改" Click="Cancel_Click" Margin="0,0,10,0"/>
      <TextBlock x:Name="ValidationMessage" Foreground="#D64C4C" TextWrapping="Wrap" Margin="0,0,16,0"/>
    </DockPanel>
  </Grid>
</UserControl>
