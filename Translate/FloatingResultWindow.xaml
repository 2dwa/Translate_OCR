<Window x:Class="Translate.FloatingResultWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Translate" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="截图结果 · Translate" Width="720" Height="600" MinWidth="600" MinHeight="440" WindowStyle="None" Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#DDE2EA" BorderThickness="1" Background="#F5F6FA"><Grid Margin="18,0,18,16">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="再截一张" Click="Capture_Click" Style="{StaticResource Quiet}" FontSize="12" IsEnabled="{Binding CanInteract}"/>
        <Button Content="主界面" Click="Open_Click" Style="{StaticResource Quiet}" FontSize="12"/>
        <Button x:Name="PinButton" Content="已置顶" Click="Pin_Click" Style="{StaticResource Quiet}" FontSize="12" ToolTip="切换置顶"/>
        <Button Content="×" Click="Close_Click" Style="{StaticResource Quiet}" FontSize="20" Padding="12,5" ToolTip="关闭悬浮窗（Esc），保留后台快捷键" AutomationProperties.Name="关闭悬浮窗"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Translate · 截图结果" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding TargetLanguage}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
    </DockPanel>
    <local:ResultView x:Name="Results" Grid.Row="1"/>
    <Border Grid.Row="2" Style="{StaticResource Card}" CornerRadius="12" Padding="12" Margin="0,12,0,0"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"/><ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding BusyVisibility}" Foreground="{StaticResource Accent}"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"><TextBlock Text="{Binding ElapsedLabel}" Style="{StaticResource Muted}" FontSize="11"/><Button Content="取消" Click="Cancel_Click" Style="{StaticResource Quiet}" Visibility="{Binding BusyVisibility}"/></StackPanel>
    </Grid></Border>
  </Grid></Border>
</Window>
