<UserControl x:Class="Translate.TranslationEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Translate">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#ECF1F9" CornerRadius="12" Padding="17,10" Margin="0,0,0,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding CanInteract}">
          <Button Content="输出设置" Style="{StaticResource Quiet}" Padding="8,6" Click="LanguageSettings_Click"/>
          <Button Content="API 与提示词" Style="{StaticResource Quiet}" Padding="8,6" Click="Settings_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="目标语言" FontSize="12" Foreground="#74859E" Margin="0,0,10,0"/><TextBlock Text="{Binding TargetLanguage}" FontSize="12" FontWeight="SemiBold" Foreground="#487AAF" TextTrimming="CharacterEllipsis" MaxWidth="200"/></StackPanel>
      </DockPanel>
    </Border>
    <local:ResultView x:Name="Results" Grid.Row="1" TextOnly="True" TranslateRequested="Translate_Click" CopyRequested="Copy_Click" ExportRequested="Export_Click"/>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,18,0,0"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="32" Height="32" Background="#EDF4FF" CornerRadius="10" Margin="0,0,13,0"><TextBlock Style="{StaticResource Icon}" Text="{Binding StatusGlyph}" Foreground="{StaticResource Accent}" FontSize="16"/></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"/><ProgressBar Height="3" Margin="0,9,15,0" Foreground="{StaticResource Accent}" Background="#EAF0F9" IsIndeterminate="True" Visibility="{Binding BusyVisibility}"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"><TextBlock Text="{Binding ElapsedLabel}" FontSize="11" Foreground="{StaticResource Secondary}"/><Button Content="取消" Click="Cancel_Click" Style="{StaticResource Quiet}" Margin="8,0,0,0" Visibility="{Binding BusyVisibility}"/></StackPanel>
    </Grid></Border>
  </Grid>
</UserControl>
