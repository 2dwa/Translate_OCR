{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Translate (system .NET SDK)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Win App: Build",
      "program": "${workspaceFolder}/Translate/bin/Debug/net10.0-windows/win-x64/Translate.exe",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Translate (local .dotnet SDK)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Win App: Build",
      "program": "${workspaceFolder}/Translate/bin/Debug/net10.0-windows/win-x64/Translate.exe",
      "cwd": "${workspaceFolder}",
      "env": { "DOTNET_ROOT": "${workspaceFolder}/.dotnet" }
    }
  ]
}
